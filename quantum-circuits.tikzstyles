\tikzstyle{gatherer}=[fill={rgb,255: red,220; green,220; blue,220}, draw=black, shape border rotate=-90, regular polygon, regular polygon sides=3, inner sep=1.5pt, rounded corners=0.5mm]
\tikzstyle{hyperedge}=[fill=white, draw=black, shape=rectangle, rounded corners=0.1cm, minimum height=.6cm, minimum width=.6cm]
\tikzstyle{square}=[fill=white, draw=black, shape=rectangle, minimum height=0.20cm, minimum width=0.20cm, inner sep=0.1em, thick]
